#
# Copy to local/.env and fill in AWS credentials. The local harness emulates
# DynamoDB, S3, and Secrets Manager, and shims AgentCore — but Bedrock model
# calls go to REAL AWS, so you need credentials with Bedrock access and Claude
# Sonnet model access enabled in the target region.
#
#   cp local/env.example local/.env
#   # edit local/.env, then:
#   make -C local up

# --- Required: AWS credentials for real Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Model (must be enabled in the Bedrock console for AWS_REGION) ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Optional overrides (defaults in local/config/harness_env.py) ---
# ARIA_BACKEND_PORT=8000
# ERPNEXT_URL=http://localhost:8080

# Seed the local ERPNext with demo data on startup (runs utilities scripts 04/05).
# Requires local ERPNext to be up and its setup wizard completed once.
ARIA_SEED_ON_START=true
