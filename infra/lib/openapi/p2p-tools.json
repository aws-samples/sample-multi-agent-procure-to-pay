  {
    "name": "extract_invoice_document",
    "description": "Extract structured invoice data from a PDF or image document stored in S3\nusing Amazon Textract AnalyzeExpense. Returns vendor name, invoice number,\ndates, amounts, PO reference, line items, and confidence scores.\n\nConfidence tiers:\n- AUTO_ACCEPT (>=95%): all critical fields high confidence\n- REVIEW (80-95%): some fields uncertain, Bedrock validates\n- MANUAL (<80%): flag for human review",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "description": "S3 bucket containing the invoice document"
        },
        "key": {
          "type": "string",
          "description": "S3 object key (file path) of the invoice PDF or image"
        }
      },
      "required": [
        "bucket",
        "key"
      ]
    }
  },
