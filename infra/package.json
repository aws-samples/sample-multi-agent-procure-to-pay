{
  "name": "p2p-infra",
  "version": "1.0.0",
  "description": "CDK stacks for P2P Agentic Platform — ERPNext, AgentCore, and frontend",
  "bin": {
    "p2p-infra": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "synth": "cdk synth",
    "e2e:synth": "cdk --app \"npx ts-node bin/e2e.ts\" synth P2PAuthE2EStack",
    "e2e:deploy": "cdk --app \"npx ts-node bin/e2e.ts\" deploy P2PAuthE2EStack --require-approval never",
    "e2e:destroy": "cdk --app \"npx ts-node bin/e2e.ts\" destroy P2PAuthE2EStack --force",
    "e2e:test": "python3 tests/e2e/run_e2e.py"
  },
  "dependencies": {
    "@aws-cdk/aws-bedrock-agentcore-alpha": "^2.248.0-alpha.0",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "aws-cdk": "^2.1143.0",
    "typescript": "~5.7.0"
  }
}
