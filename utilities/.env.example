# ERPNext Connection Configuration
# Copy this to .env and fill in values for your environment.

# ERPNext URL (update with your ALB / EC2 endpoint after deployment)
ERPNEXT_URL=https://erp.your-domain.example.com

# Admin credentials (must match the values you supplied to the ErpNextStack
# CDK context: erpnextAdminPassword). Used by 04-07 scripts.
ERPNEXT_USER=Administrator
ERPNEXT_PASSWORD=

# Demo persona password (script 02 sets this on every demo user it creates;
# scripts 03/04 reuse it to authenticate as those personas). Pick a strong
# value — example: openssl rand -base64 24
ERPNEXT_USER_PASSWORD=

# (Optional) API key/secret pair for the service account, populated by
# script 03_setup_erpnext_oauth.py and used as a fallback when no per-user
# credentials are configured.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
